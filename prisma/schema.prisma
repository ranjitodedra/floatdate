datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model University {
  id            String   @id @default(uuid())
  slug          String   @unique    // "laurier", "waterloo", "uoft", etc.
  name          String               // "Wilfrid Laurier University"
  emailDomain   String   @unique    // "mylaurier.ca", "uwaterloo.ca", etc.
  campuses      Json     @default("[]") // ["Waterloo","Brantford","Milton"]
  createdAt     DateTime @default(now())

  users          User[]
  pendingSignups PendingSignup[]
  matchRuns      MatchRun[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String
  age            Int
  gender         String       // "male" | "female" | "nonbinary"
  genderPref     String       // "male" | "female" | "any"
  city           String
  bio            String?
  passwordHash   String
  universityId       String
  completedSetup     Boolean      @default(false)
  emailVerified      Boolean      @default(true)
  notifyPreference   String?
  phoneVerified      Boolean      @default(false)
  createdAt          DateTime     @default(now())

  university     University   @relation(fields: [universityId], references: [id])
  answers        Answer[]
  optIns         WeeklyOptIn[]
  matchesA       Match[]      @relation("matchUserA")
  matchesB       Match[]      @relation("matchUserB")
  matchAttempts  MatchAttempt[]
  emailLogs      EmailLog[]
  floatLiveParticipations FloatLiveParticipant[]
  matchFeedbacks MatchFeedback[]
}

model Question {
  id              String   @id @default(uuid())
  orderIndex      Int      @unique       // 1–60
  questionText    String
  type            String                  // "likert" | "multiple_choice" | "ranking" | "binary"
  options         Json                    // ["Strongly Disagree","Disagree","Neutral","Agree","Strongly Agree"]
  weightDimension String                  // e.g. "attachment", "values", "lifestyle", "communication", "interests"
  weight          Float    @default(1.0)  // importance multiplier within dimension

  answers         Answer[]
}

model Answer {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  value      Json     // numeric for likert/binary, string for MC, array for ranking
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

model WeeklyOptIn {
  id        String   @id @default(uuid())
  userId    String
  weekStart DateTime // Monday 00:00 UTC of that week
  optedInAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, weekStart])
}

model Match {
  id              String   @id @default(uuid())
  userAId         String
  userBId         String
  weekStart       DateTime
  similarityScore Float
  explanation     String   // "You both value deep conversations and share lifestyle preferences."
  createdAt       DateTime @default(now())

  userA           User     @relation("matchUserA", fields: [userAId], references: [id])
  userB           User     @relation("matchUserB", fields: [userBId], references: [id])
  attempts        MatchAttempt[]
  feedbacks       MatchFeedback[]

  @@unique([userAId, weekStart])
  @@unique([userBId, weekStart])
}

model MatchRun {
  id             String   @id @default(uuid())
  weekStart      DateTime
  universityId   String?
  source         String   @default("weekly")
  matchedCount   Int      @default(0)
  unmatchedCount Int      @default(0)
  createdAt      DateTime @default(now())

  university     University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  attempts       MatchAttempt[]

  @@index([weekStart])
  @@index([universityId])
}

model MatchAttempt {
  id         String    @id @default(uuid())
  runId      String
  userId     String
  matchId    String?
  weekStart  DateTime
  status     String    // "matched" | "no_match"
  feedback   String?   // "communicated" | "went_on_date" | "nothing_happened"
  feedbackAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  run        MatchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match      Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([runId, userId])
  @@index([userId, createdAt])
  @@index([weekStart])
  @@index([matchId])
}

model EmailLog {
  id        String   @id @default(uuid())
  userId    String
  matchId   String
  sentAt    DateTime @default(now())
  status    String   // "sent" | "failed" | "bounced"
  messageId String?

  user      User     @relation(fields: [userId], references: [id])
}

model PendingSignup {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String
  age                Int
  gender             String
  genderPref         String
  city               String
  bio                String?
  passwordHash       String
  universityId       String
  verifyToken        String   @unique
  verifyTokenExpiry  DateTime
  createdAt          DateTime @default(now())

  university     University   @relation(fields: [universityId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ============================================
// FLOAT LIVE — New models (additive migration)
// ============================================

model FloatLiveSession {
  id             String   @id @default(uuid())
  date           DateTime // The date of the live session (date only, no time)
  startTime      DateTime // 5:00 PM ET converted to UTC
  endTime        DateTime // 6:00 PM ET converted to UTC
  createdAt      DateTime @default(now())

  participants   FloatLiveParticipant[]
  chatRooms      FloatLiveChatRoom[]
}

model FloatLiveParticipant {
  id             String   @id @default(uuid())
  userId         String
  sessionId      String
  gender         String   // "male" | "female" | "nonbinary" — copied from User at join time
  preference     String   // "male" | "female" | "nonbinary" | "any" — who they want to chat with
  intention      String   // "blind_date" | "friendship"
  campus         String   // Campus filter value
  character      String   @default("A") // Character avatar letter: "A" | "B" | "C" | "D" | "E" | "F"
  isOnline       Boolean  @default(true)
  acceptedTerms  Boolean  @default(false)
  joinedAt       DateTime @default(now())
  leftAt         DateTime?
  lastSeenAt     DateTime?
  status         String   @default("idle") // idle | waiting | matched | left
  connectionId   String?

  user           User     @relation(fields: [userId], references: [id])
  session        FloatLiveSession @relation(fields: [sessionId], references: [id])

  chatRoomsAsA   FloatLiveChatRoom[] @relation("chatParticipantA")
  chatRoomsAsB   FloatLiveChatRoom[] @relation("chatParticipantB")
  roomParticipations FloatLiveRoomParticipant[]

  @@unique([userId, sessionId])
  @@index([sessionId, status, lastSeenAt])
}

model FloatLiveChatRoom {
  id                String   @id @default(uuid())
  sessionId         String
  participantAId    String
  participantBId    String
  intention         String   // "blind_date" | "friendship"
  emailRevealedByA  Boolean  @default(false)
  emailRevealedByB  Boolean  @default(false)
  isActive          Boolean  @default(true)
  status            String   @default("active") // active | ended
  endedReason       String?  // user_exit | timeout | session_end
  startedAt         DateTime @default(now())
  endedAt           DateTime?

  session        FloatLiveSession @relation(fields: [sessionId], references: [id])
  participantA   FloatLiveParticipant @relation("chatParticipantA", fields: [participantAId], references: [id])
  participantB   FloatLiveParticipant @relation("chatParticipantB", fields: [participantBId], references: [id])

  messages       FloatLiveChatMessage[]
  reports        FloatLiveReport[]
  roomParticipants FloatLiveRoomParticipant[]

  @@unique([participantAId, participantBId, sessionId])
}

model FloatLiveRoomParticipant {
  id             String   @id @default(uuid())
  roomId         String
  participantId  String
  userId         String
  role           String   // A | B
  status         String   @default("online") // online | away | left
  lastSeenAt     DateTime @default(now())
  awaySince      DateTime?
  joinedAt       DateTime @default(now())
  connectionId   String?

  room           FloatLiveChatRoom @relation(fields: [roomId], references: [id])
  participant    FloatLiveParticipant @relation(fields: [participantId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId, lastSeenAt])
}

model FloatLiveChatMessage {
  id           String   @id @default(uuid())
  chatRoomId   String
  senderId     String   // References User.id
  content      String
  isDeleted    Boolean  @default(false)  // Soft delete — hidden from UI, kept in DB
  createdAt    DateTime @default(now())

  chatRoom     FloatLiveChatRoom @relation(fields: [chatRoomId], references: [id])
}

model FloatLiveReport {
  id            String   @id @default(uuid())
  chatRoomId    String
  reporterId    String   // User who reported
  reportedId    String   // User who was reported
  reason        String   // "harassment" | "spam" | "inappropriate" | "other"
  details       String?  // Optional free-text details
  status        String   @default("pending") // "pending" | "reviewed" | "action_taken" | "dismissed"
  adminNotes    String?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  chatRoom      FloatLiveChatRoom @relation(fields: [chatRoomId], references: [id])
}

model FloatLiveSettings {
  id         String   @id @default("singleton")
  startHour  Int      @default(17) // 24-hour format, e.g. 17 = 5 PM
  endHour    Int      @default(18) // 24-hour format, e.g. 18 = 6 PM
  updatedAt  DateTime @default(now()) @updatedAt
}

model MatchFeedback {
  id           String   @id @default(uuid())
  matchId      String
  userId       String
  howItWent    String   // e.g. "never_started", "chatted", "great_conversation", etc.
  feedbackText String?  // Optional free-form text from Question 2
  createdAt    DateTime @default(now())

  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
  @@index([matchId])
}
