# FloatDate environment variables
# Copy to .env and fill in real values: cp .env.example .env

# --- Database (required) ---
# Supabase Postgres connection string (use pooler, port 6543, for Vercel/serverless)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct connection for pg_dump only (optional; port 5432 session mode)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Auth (required in production) ---
# HS256 signing secret for session cookies (min 32 characters in production)
JWT_SECRET=your-jwt-secret-here-min-32-chars
# Bearer token for admin/cron API routes (run-matching, cleanup, email previews)
CRON_SECRET=your-cron-secret-here

# --- App URL (required) ---
# Public base URL used in emails and referral links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin access (required in production) ---
# Comma-separated emails allowed to access /admin
ADMIN_EMAILS=admin@example.com
# Mirror ADMIN_EMAILS for client-side UI checks (signup form, optional if using API isAdmin)
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# --- Email — match notifications via Gmail SMTP ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAILS_ENABLED=false
EMAIL_FROM_NAME=FloatDate Team
EMAIL_FROM=your-email@gmail.com

# --- Email — verification & password reset via PrivateMail SMTP ---
VERIFY_EMAIL_HOST=mail.privateemail.com
VERIFY_EMAIL_PORT=465
VERIFY_EMAIL_USER=verify@yourdomain.com
VERIFY_EMAIL_PASS=your-privatemail-password

# --- Supabase (required for Float Live realtime & file storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Rate limiting (optional; degrades gracefully if unset) ---
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# --- Feature flags (optional) ---
# Enable V2 grounded match reasoning explanations
MATCH_REASONING_V2=false
# Enforce referral code gate on signup
REFERRAL_GATE_ENABLED=false
# ISO datetime deadline for campus show applications
SHOW_APPLICATION_DEADLINE=

# --- Scripts (optional) ---
# Path to pg_dump binary if not on PATH
PG_DUMP=
